{
  "name": "data-hub-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Data Hub 航天数据资产门户的四个视觉方案（默认展示 D 数据舱，全部为演示数据）",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4181",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4181",
    "check": "node --experimental-strip-types scripts/check-data.ts && node --experimental-strip-types scripts/check-variant-d.ts"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "d3-hierarchy": "^3.1.3",
    "d3-shape": "^3.2.1",
    "lucide-react": "^1.67.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "tailwindcss": "^4.3.4",
    "typescript": "~5.9.3",
    "vite": "^7.3.7"
  }
}
